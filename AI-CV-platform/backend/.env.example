# 复制到项目根目录并改名为 .env 后生效（前缀固定为 AICV_）
# 所有配置都有默认值，不配置也能完整运行（AI 助手会走内置规则引擎）。

# 数据与数据库（默认 <repo>/data，SQLite 单文件，便于整体打包迁移）
# AICV_DATA_DIR=/opt/AI-CV-platform/data
# AICV_DATABASE_URL=sqlite:////opt/AI-CV-platform/data/platform.db

# 预览与缩略图（原图始终保留，仅预览做降采样）
# AICV_MAX_PREVIEW_SIDE=2048
# AICV_THUMBNAIL_SIDE=256

# 批量测试 / 运行时线程数
# AICV_MAX_WORKERS=4

# AI 助手（OpenAI 兼容接口：填了 key 才启用大模型，否则用规则引擎）
# AICV_LLM_BASE_URL=https://api.openai.com/v1
# AICV_LLM_API_KEY=sk-xxxx
# AICV_LLM_MODEL=gpt-4o-mini
# AICV_LLM_TIMEOUT=60

# 跨域（前端 dev server 走 Vite 代理，一般不需要改）
# AICV_CORS_ORIGINS=["http://localhost:5173"]
